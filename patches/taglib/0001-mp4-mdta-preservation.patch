+void MP4::Tag::copyStateTo(MP4::Tag &destination) const
+{
+  destination.d->items = d->items;
+  destination.d->mdtaItems = d->mdtaItems;
+  destination.d->rawMdtaItems = d->rawMdtaItems;
+  destination.d->rawOpaqueItems = d->rawOpaqueItems;
