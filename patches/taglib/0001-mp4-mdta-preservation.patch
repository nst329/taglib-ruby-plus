+  destination.d->removedMdtaKeys = d->removedMdtaKeys;
+}
+
+const MP4::MdtaItemList &MP4::Tag::mdtaItems() const
+{
+  return d->mdtaItems;
+}
+
+bool MP4::Tag::setMdtaItem(const String &key, unsigned int dataType,
+                           unsigned int locale, const ByteVector &data)
+{
+  for(auto &item : d->mdtaItems) {
+    if(item.key == key) {
+      item.dataType = dataType;
+      item.locale = locale;
+      item.data = data;
+      d->changedMdtaKeys.insert(key);
+      d->removedMdtaKeys.erase(key);
+      return true;
+    }
+  }
+  return false;
+}
+
+bool MP4::Tag::removeMdtaItem(const String &key)
+{
+  bool found = false;
+  for(auto it = d->mdtaItems.begin(); it != d->mdtaItems.end();) {
+    if(it->key == key) {
+      it = d->mdtaItems.erase(it);
+      found = true;
+    }
+    else {
+      ++it;
+    }
+  }
+  if(found) {
+    d->changedMdtaKeys.insert(key);
+    d->removedMdtaKeys.insert(key);
+  }
+  return found;
+}
+
