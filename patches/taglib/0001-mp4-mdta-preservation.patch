+
+bool MP4::Tag::applyChanges(const ItemMap &setItems,
+                            const StringList &removeItems,
+                            const StringList &removeMdtaKeys)
+{
+  if(!removeMdtaKeys.isEmpty() &&
+     (d->mdtaAmbiguous || (d->mdta.mdtaDocument && !d->mdta.keysValid)))
+    return false;
+
+  MP4::Tag candidate;
+  copyStateTo(candidate);
+  for(const auto &key : removeItems)
+    candidate.removeItem(key);
+  for(const auto &[key, item] : setItems)
+    candidate.setItem(key, item);
+  for(const auto &key : removeMdtaKeys) {
+    if(candidate.d->mdta.hasKey(key) && !candidate.d->mdta.remove(key))
+      return false;
+  }
+  candidate.copyStateTo(*this);
+  return true;
+}
