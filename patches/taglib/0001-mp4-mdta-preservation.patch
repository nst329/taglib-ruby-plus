+struct RawMdtaItem
+{
+  unsigned int keyIndex { 0 };
+  String key;
+  ByteVector bytes;
+};
+
+struct ParsedMdta
+{
+  std::vector<RawMdtaItem> rawItems;
+  MP4::MdtaItemList items;
+};
+
+ByteVector readAtomData(TagLib::File *file, const MP4::Atom *atom)
+{
+  file->seek(atom->offset() + 8);
+  return file->readBlock(atom->length() - 8);
+}
+
+ByteVector atomBytes(TagLib::File *file, const MP4::Atom *atom)
+{
+  file->seek(atom->offset());
+  return file->readBlock(atom->length());
+}
+
+String metaHandler(TagLib::File *file, const MP4::Atom *meta)
+{
+  for(const auto *child : meta->children()) {
+    if(child->name() != "hdlr")
+      continue;
+    const ByteVector data = readAtomData(file, child);
+    if(data.size() >= 12)
+      return String(data.mid(8, 4), String::Latin1);
+  }
+  return String();
+}
+
+std::vector<String> metaKeys(TagLib::File *file, const MP4::Atom *meta,
+                             bool *valid = nullptr)
+{
+  if(valid)
+    *valid = false;
+  const MP4::Atom *keys = nullptr;
+  for(const auto *child : meta->children()) {
+    if(child->name() == "keys") {
+      keys = child;
+      break;
+    }
+  }
+  if(!keys)
+    return {};
+
+  const ByteVector data = readAtomData(file, keys);
+  if(data.size() < 8)
+    return {};
+  const unsigned int count = data.toUInt(4U, true);
+  std::vector<String> result;
+  result.reserve(count);
+  size_t pos = 8;
+  for(unsigned int i = 0; i < count && pos + 8 <= data.size(); ++i) {
+    const unsigned int size = data.toUInt(static_cast<unsigned int>(pos), true);
+    if(size < 8 || pos + size > data.size())
+      return {};
+    result.emplace_back(data.mid(pos + 8, size - 8), String::UTF8);
+    pos += size;
+  }
+  if(result.size() != count)
+    return {};
+  if(valid)
+    *valid = true;
+  return result;
+}
+
+ParsedMdta parseMdtaItem(const ByteVector &bytes, unsigned int keyIndex,
+                         const String &key)
+{
+  ParsedMdta result;
+  result.rawItems.push_back({keyIndex, key, bytes});
+  size_t pos = 8;
+  while(pos + 8 <= bytes.size()) {
+    const unsigned int size = bytes.toUInt(static_cast<unsigned int>(pos), true);
+    if(size < 16 || pos + size > bytes.size() || bytes.mid(pos + 4, 4) != "data")
+      return result;
+    result.items.append({key, keyIndex, bytes.toUInt(static_cast<unsigned int>(pos + 8), true),
+                         bytes.toUInt(static_cast<unsigned int>(pos + 12), true),
+                         bytes.mid(pos + 16, size - 16)});
+    pos += size;
+  }
+  return result;
+}
+
+ByteVector renderMdtaItem(unsigned int keyIndex, unsigned int dataType,
+                          unsigned int locale, const ByteVector &payload)
+{
+  const ByteVector data = ByteVector::fromUInt(16 + payload.size()) + ByteVector("data", 4) +
+                          ByteVector::fromUInt(dataType) + ByteVector::fromUInt(locale) + payload;
+  return ByteVector::fromUInt(8 + data.size()) + ByteVector::fromUInt(keyIndex) + data;
+}
+
+ByteVector renderMdtaKeys(const std::vector<String> &keys)
+{
+  ByteVector data = ByteVector(4, '\0') + ByteVector::fromUInt(keys.size());
+  for(const auto &key : keys) {
+    const ByteVector value = ByteVector("mdta", 4) + key.data(String::UTF8);
+    data.append(ByteVector::fromUInt(4 + value.size()) + value);
+  }
+  return ByteVector::fromUInt(8 + data.size()) + ByteVector("keys", 4) + data;
+}
+
+ByteVector renderOpaqueTextItem(const String &name, const MP4::Item &item)
+{
+  if(name.data(String::Latin1).size() != 4 || item.type() != MP4::Item::Type::StringList)
+    return {};
+
+  ByteVector children;
+  for(const auto &value : item.toStringList()) {
+    const ByteVector payload = value.data(String::UTF8);
+    const ByteVector data = ByteVector::fromUInt(16 + payload.size()) + ByteVector("data", 4) +
+                            ByteVector::fromUInt(1) + ByteVector::fromUInt(0) + payload;
+    children.append(data);
+  }
+  const ByteVector nameBytes = name.data(String::Latin1);
+  return ByteVector::fromUInt(8 + children.size()) + nameBytes + children;
+}
+
+struct MdtaState
+{
+  std::vector<String> keys;
+  MP4::MdtaItemList items;
+  std::vector<RawMdtaItem> rawItems;
+  std::set<String> changedKeys;
+  std::set<String> removedKeys;
+  MP4::Atom *ilst { nullptr };
+  MP4::Atom *keysAtom { nullptr };
+  bool mdtaDocument { false };
+  bool keysValid { true };
+  bool keysChanged { false };
+
+  bool present() const
+  {
+    return mdtaDocument && keysValid;
+  }
+
+  bool hasKey(const String &key) const
+  {
+    return std::find(keys.begin(), keys.end(), key) != keys.end();
+  }
+
+  unsigned int keyIndex(const String &key) const
+  {
+    const auto it = std::find(keys.begin(), keys.end(), key);
+    return it == keys.end() ? 0 : static_cast<unsigned int>(std::distance(keys.begin(), it)) + 1;
+  }
+
+  static ByteVector rewriteKeyIndex(const RawMdtaItem &raw, unsigned int keyIndex)
+  {
+    if(keyIndex == raw.keyIndex || raw.bytes.size() < 8)
+      return raw.bytes;
+    return raw.bytes.mid(0, 4) + ByteVector::fromUInt(keyIndex) + raw.bytes.mid(8);
+  }
+
+  ByteVector renderItems() const
+  {
+    ByteVector result;
+    std::set<String> emitted;
+    for(const auto &raw : rawItems) {
+      if(removedKeys.find(raw.key) != removedKeys.end())
+        continue;
+      if(changedKeys.find(raw.key) == changedKeys.end()) {
+        result.append(rewriteKeyIndex(raw, keyIndex(raw.key)));
+        continue;
+      }
+      if(emitted.insert(raw.key).second) {
+        for(const auto &item : items) {
+          if(item.key == raw.key)
+            result.append(renderMdtaItem(item.keyIndex, item.dataType,
+                                         item.locale, item.data));
+        }
+      }
+    }
+    for(const auto &item : items) {
+      if(changedKeys.find(item.key) != changedKeys.end() &&
+         emitted.insert(item.key).second)
+        result.append(renderMdtaItem(item.keyIndex, item.dataType,
+                                     item.locale, item.data));
+    }
+    return result;
+  }
+
+  bool replace(const String &key, unsigned int dataType, unsigned int locale,
+               const ByteVector &data)
+  {
+    if(!present())
+      return false;
+
+    unsigned int keyIndex = 0;
+    auto first = items.end();
+    for(auto it = items.begin(); it != items.end();) {
+      if(it->key != key) {
+        ++it;
+        continue;
+      }
+      if(first == items.end()) {
+        first = it++;
+        keyIndex = first->keyIndex;
+      }
+      else {
+        it = items.erase(it);
+      }
+    }
+    if(keyIndex == 0) {
+      auto keyIt = std::find(keys.begin(), keys.end(), key);
+      if(keyIt == keys.end()) {
+        keys.push_back(key);
+        keyIndex = static_cast<unsigned int>(keys.size());
+        keysChanged = true;
+      }
+      else {
+        keyIndex = static_cast<unsigned int>(std::distance(keys.begin(), keyIt)) + 1;
+      }
+    }
+    if(first == items.end())
+      items.append({key, keyIndex, dataType, locale, data});
+    else {
+      first->dataType = dataType;
+      first->locale = locale;
+      first->data = data;
+    }
+    changedKeys.insert(key);
+    removedKeys.erase(key);
+    return true;
+  }
+
+  bool remove(const String &key)
+  {
+    const auto keyIt = std::find(keys.begin(), keys.end(), key);
+    if(keyIt == keys.end())
+      return false;
+
+    const unsigned int removedIndex = static_cast<unsigned int>(std::distance(keys.begin(), keyIt)) + 1;
+    keys.erase(keyIt);
+    for(auto &item : items) {
+      if(item.keyIndex > removedIndex)
+        --item.keyIndex;
+    }
+    for(auto it = items.begin(); it != items.end();) {
+      if(it->key == key)
+        it = items.erase(it);
+      else
+        ++it;
+    }
+    keysChanged = true;
+    changedKeys.insert(key);
+    removedKeys.insert(key);
+    return true;
+  }
+};
