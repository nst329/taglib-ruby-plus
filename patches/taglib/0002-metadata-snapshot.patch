+++ b/taglib/mp4/mp4metadatahelpers.h
@@ -0,0 +1,37 @@
+// Binding-only helpers: validate the actual writer/parser contract before a candidate commit.
+#ifndef TAGLIB_MP4METADATAHELPERS_H
+#define TAGLIB_MP4METADATAHELPERS_H
+#include "tbytevectorstream.h"
+#include "mp4itemfactory.h"
+#include <limits>
+
+namespace {
+// A read-only in-memory File is enough for Atom and ItemFactory; no media file is created.
+class MetadataMemoryFile final : public TagLib::File {
+public:
+  explicit MetadataMemoryFile(TagLib::IOStream *stream) : TagLib::File(stream) {}
+  TagLib::Tag *tag() const override { return nullptr; }
+  TagLib::AudioProperties *audioProperties() const override { return nullptr; }
+  bool save() override { return false; }
+};
+
+bool metadataItemRoundTrips(const TagLib::MP4::ItemFactory *factory,
+                           const TagLib::String &key, const TagLib::MP4::Item &item)
+{
+  const auto bytes = factory->renderItem(key, item);
+  if(bytes.size() < 8 || !item.isValid()) return false;
+  TagLib::ByteVectorStream stream(bytes);
+  MetadataMemoryFile file(&stream);
+  TagLib::MP4::Atom atom(&file);
+  const auto parsed = factory->parseItem(&atom, bytes.mid(8));
+  return parsed.first == key && parsed.second == item;
+}
+
+bool metadataLength(uint64_t &total, uint64_t amount)
+{
+  if(amount > UINT32_MAX || total > UINT32_MAX - amount) return false;
+  total += amount;
+  return true;
+}
+}
+#endif
