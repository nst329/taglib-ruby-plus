+StringList MP4::Tag::metadataKeys() const
+{
+  StringList result;
+  if(metadataStatus() == 1) for(const auto &key : d->mdta.keys) result.append(key);
+  return result;
+}
+
+bool MP4::Tag::metadataItemSupported(const String &key, const Item &item) const
+{
+  const auto atomName = key.data(String::Latin1).mid(0, 4);
+  if(metadataStatus() == 1 && !d->factory->nameHandlerMap().contains(atomName) &&
+     d->factory->propertyKeyForName(atomName).isEmpty()) return false;
+  return metadataItemRoundTrips(d->factory, key, item);
+}
+
+// Work only on owned candidate containers; no public Tag or live atom tree is edited before commit.
+bool MP4::Tag::restoreMetadata(const ItemMap &items, const StringList &keys,
+                               const MdtaItemList &values)
+{
+  const int status = metadataStatus();
+  if(status == 2 || (status == 0 && (!keys.isEmpty() || !values.isEmpty()))) return false;
+  auto candidateItems = items;
+  auto state = d->mdta;
+  uint64_t ordinaryLength = 8;
+  for(const auto &[key, item] : candidateItems) {
+    if(!metadataItemSupported(key, item) ||
+       !metadataLength(ordinaryLength, d->factory->renderItem(key, item).size())) return false;
+  }
+  std::set<String> sourceKeys;
+  for(const auto &key : keys) {
+    const ByteVector bytes = key.data(String::UTF8);
+    if(key.isEmpty() || std::find(bytes.begin(), bytes.end(), '\0') != bytes.end() ||
+       !sourceKeys.insert(key).second) return false;
+    if(!state.hasKey(key)) {
+      state.keys.push_back(key);
+      state.keysChanged = true;
+    }
+  }
+  MdtaItemList records;
+  for(const auto &value : values) {
+    if(!sourceKeys.count(value.key)) return false;
+    records.append(value);
+  }
+  uint64_t keysLength = 16;
+  for(const auto &key : state.keys)
+    if(!metadataLength(keysLength, 8ULL + key.data(String::UTF8).size())) return false;
+  uint64_t valuesLength = ordinaryLength;
+  std::set<String> emitted;
+  for(auto &record : records) {
+    record.keyIndex = state.keyIndex(record.key);
+    if(!record.keyIndex || !metadataLength(valuesLength, 16ULL + record.data.size())) return false;
+    if(emitted.insert(record.key).second && !metadataLength(valuesLength, 8)) return false;
+  }
+  for(const auto &key : state.keys) {
+    state.changedKeys.insert(key);
+    state.removedKeys.insert(key); // Clear values without deleting keys or reindexing.
+  }
+  for(const auto &record : records) state.removedKeys.erase(record.key);
+  state.items = std::move(records);
+  // All throwing allocations/copies completed before either live container changes.
+  d->items = std::move(candidateItems);
+  d->mdta = std::move(state);
+  return true;
 }

