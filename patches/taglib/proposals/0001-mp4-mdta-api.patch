+// A conservative upper bound protects every parent and chunk offset before any write.
+bool MP4::Tag::preflightGrowth(uint64_t growth, bool require32BitFile) const
+{
+  if(d->file->length() < 0 || !MdtaInternal::fitsGrowth(d->file->length(), growth,
+        require32BitFile ? 0xffffffffULL :
+          static_cast<uint64_t>(std::numeric_limits<offset_t>::max()))) return false;
+  const auto *moov = d->atoms->find("moov");
+  if(!moov) return false;
+  std::vector<const Atom *> pending {moov};
+  while(!pending.empty()) {
+    const auto *atom = pending.back(); pending.pop_back();
+    if(atom->length() < 8 || !MdtaInternal::fitsGrowth(atom->length(), growth, 0xffffffffULL))
+      return false;
+    d->file->seek(atom->offset());
+    if(d->file->readBlock(4).toUInt() == 1) return false;
+    for(const auto *child : atom->children()) pending.push_back(child);
+    if(atom->name() != "stco" && atom->name() != "co64") continue;
+    if(atom->length() < 16) return false;
+    d->file->seek(atom->offset() + 12);
+    const ByteVector data = d->file->readBlock(atom->length() - 12);
+    const unsigned int width = atom->name() == "stco" ? 4 : 8;
+    if(data.size() < 4 || data.toUInt() > (data.size() - 4) / width) return false;
+    const uint64_t limit = width == 4 ? 0xffffffffULL :
+      static_cast<uint64_t>(std::numeric_limits<offset_t>::max());
+    for(unsigned int i = 0; i < data.toUInt(); ++i) {
+      const unsigned int pos = 4 + i * width;
+      const uint64_t offset = width == 4 ? data.toUInt(pos) : data.toULongLong(pos);
+      if(offset > static_cast<uint64_t>(d->file->length()) ||
+         !MdtaInternal::fitsGrowth(offset, growth, limit)) return false;
+    }
+  }
+  return true;
