+// Replace the stale atom tree after successful metadata or chapter writes.
+bool MP4::File::refreshMetadata(bool commit)
+{
+  auto atoms = std::make_unique<Atoms>(this);
+  if(!atoms->checkRootLevelAtoms() || !atoms->find("moov")) {
+    setValid(false);
+    return false;
+  }
+  if(!d->tag->rebindAtoms(atoms.get(), commit)) {
+    setValid(false);
+    return false;
+  }
+  d->atoms = std::move(atoms);
+  return true;
+}
