+MP4::MdtaStatus MP4::Tag::mdtaStatus() const
+{
+  if(!d->detectedMdta && !d->mdta.mdtaDocument)
+    return MdtaStatus::Absent;
+  return !d->mdtaAmbiguous && d->mdta.present() && d->mdta.ilst
+    ? MdtaStatus::Editable : MdtaStatus::Unsupported;
