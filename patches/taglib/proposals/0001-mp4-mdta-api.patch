+// Validate disk state before rebinding; keep pending edits until the whole save commits.
+bool MP4::Tag::rebindAtoms(Atoms *atoms, bool commit)
+{
+  Tag parsed(d->file, atoms, d->factory);
+  if(parsed.mdtaStatus() != mdtaStatus() || parsed.mdtaItems() != mdtaItems() ||
+     parsed.d->items.size() != d->items.size()) return false;
+  for(const auto &[name, item] : std::as_const(d->items)) {
+    if(!parsed.d->items.contains(name)) return false;
+    if(d->factory->renderItem(name, item) !=
+       d->factory->renderItem(name, parsed.d->items[name])) return false;
+  }
+  if(commit) {
+    d->items = parsed.d->items;
+    d->mdta = std::move(parsed.d->mdta);
+    d->rawOpaqueItems = std::move(parsed.d->rawOpaqueItems);
+  }
+  else {
+    d->mdta.ilst = parsed.d->mdta.ilst;
+    d->mdta.keysAtom = parsed.d->mdta.keysAtom;
+  }
+  d->mdtaAmbiguous = parsed.d->mdtaAmbiguous;
+  d->detectedMdta = parsed.d->detectedMdta;
+  d->atoms = atoms;
+  return true;
