+namespace TagLib::MP4 {
+// Carry one wire value without embedding keys table identity.
+class TAGLIB_EXPORT MdtaValue {
+public:
+  MdtaValue(unsigned int dataType, unsigned int locale, const ByteVector &data);
+  MdtaValue(const MdtaValue &other);
+  MdtaValue &operator=(const MdtaValue &other);
+  ~MdtaValue();
+  void swap(MdtaValue &other) noexcept;
+  unsigned int dataType() const;
+  unsigned int locale() const;
+  ByteVector data() const;
+  bool operator==(const MdtaValue &other) const;
+private:
+  class MdtaValuePrivate;
+  std::shared_ptr<MdtaValuePrivate> d;
+};
+// Example: values.append(MdtaValue(1, 1041, ByteVector("text", 4))).
+using MdtaValueList = List<MdtaValue>;
+
+// Expose a detached snapshot of one key and its ordered values.
+class TAGLIB_EXPORT MdtaItem {
+public:
+  MdtaItem(const String &key, unsigned int keyIndex, const MdtaValueList &values);
+  MdtaItem(const MdtaItem &other);
+  MdtaItem &operator=(const MdtaItem &other);
+  ~MdtaItem();
+  void swap(MdtaItem &other) noexcept;
+  String key() const;
