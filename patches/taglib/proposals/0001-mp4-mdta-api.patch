+
+MP4::MdtaItemList MP4::Tag::mdtaItems() const
+{
+  MdtaItemList result;
+  if(mdtaStatus() != MdtaStatus::Editable) return result;
+  for(unsigned int i = 0; i < d->mdta.keys.size(); ++i) {
+    MdtaValueList values;
+    for(const auto &record : d->mdta.items) {
+      if(record.keyIndex == i + 1)
+        values.append(MdtaValue(record.dataType, record.locale, record.data));
+    }
+    result.append(MdtaItem(d->mdta.keys[i], i + 1, values));
+  }
+  return result;
+}
+
+bool MP4::Tag::replaceMdtaItems(const String &key, const MdtaValueList &values)
+{
+  const ByteVector keyBytes = key.data(String::UTF8);
+  if(mdtaStatus() != MdtaStatus::Editable || key.isEmpty() || values.isEmpty() ||
+     std::find(keyBytes.begin(), keyBytes.end(), '\0') != keyBytes.end())
+    return false;
+  uint64_t total = 8;
+  MdtaRecordList records;
+  for(const auto &value : values) {
+    const ByteVector data = value.data();
+    if(!MdtaInternal::appendDataLength(total, data.size())) return false;
+    records.append({key, 0, value.dataType(), value.locale(), data});
+  }
+  MdtaState candidate = d->mdta;
+  if(!candidate.replaceAll(key, records)) return false;
+  uint64_t keysLength = 16;
+  for(const auto &entry : candidate.keys) {
+    if(!MdtaInternal::appendLength(keysLength, 8ULL + entry.data(String::UTF8).size())) return false;
+  }
+  uint64_t ilstLength = 8;
+  std::set<String> checked;
+  for(const auto &record : candidate.items) {
+    if(!checked.insert(record.key).second) continue;
+    uint64_t itemLength = 8;
+    for(const auto &value : candidate.items) {
+      if(value.key == record.key && !MdtaInternal::appendDataLength(itemLength, value.data.size()))
+        return false;
+    }
+    if(!MdtaInternal::appendLength(ilstLength, itemLength)) return false;
+  }
+  d->mdta = std::move(candidate);
+  return true;
+}
+
+bool MP4::Tag::removeMdtaItem(const String &key)
+{
+  if(mdtaStatus() != MdtaStatus::Editable) return false;
+  if(!d->mdta.hasKey(key)) return true;
+  MdtaState candidate = d->mdta;
+  if(!candidate.remove(key)) return false;
+  d->mdta = std::move(candidate);
+  return true;
+}
